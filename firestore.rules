rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    function uidUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "thebadencompany@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'maker', 'pro', 'free'];
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'role', 'qtyOnHand']) &&
             data.id is string &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['focal', 'secondary', 'accent', 'filler', 'greenery', 'base', 'ribbon'] &&
             data.qtyOnHand is number && data.qtyOnHand >= 0;
    }

    function isValidBlueprint(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200;
    }

    function isValidWreathDNA(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'dna']) &&
             data.id is string &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.dna is map;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'status', 'priority']) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ['pending', 'in_progress', 'completed'] &&
             data.priority in ['low', 'medium', 'high'];
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'status']) &&
             data.id is string &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.status in ['active', 'on_hold', 'completed', 'archived'];
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && ((isOwner(userId) && request.resource.data.role == 'free') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /blueprints/{blueprintId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidBlueprint(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidBlueprint(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /wreathDNA/{dnaId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidWreathDNA(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidWreathDNA(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /savedTrends/{trendId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && uidUnchanged();
      allow update: if isDocOwner() && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTask(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidTask(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidProject(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidProject(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
